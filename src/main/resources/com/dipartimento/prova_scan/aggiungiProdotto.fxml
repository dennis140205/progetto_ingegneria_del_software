<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.dipartimento.prova_scan.AggiungiProdottoController"
      spacing="10" fillWidth="true">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Aggiungi Prodotto" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10" VBox.vgrow="ALWAYS">
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
            <ColumnConstraints hgrow="NEVER"/>
        </columnConstraints>

        <Label text="Nome:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="campoNome" GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="2" maxWidth="Infinity"/>

        <Label text="Marca:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="campoMarca" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2" maxWidth="Infinity"/>

        <Label text="Categoria:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="campoCategoria" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2" maxWidth="Infinity"/>

        <Label text="Barcode:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="campoBarcode" GridPane.rowIndex="3" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <HBox spacing="5" GridPane.rowIndex="3" GridPane.columnIndex="2" alignment="CENTER_LEFT">
            <Button fx:id="btnScanBarcode" text="📷" onAction="#scansionaEInserisciBarcode" styleClass="button-icon"/>
            <Button fx:id="btnSearchBarcode" text="Cerca" onAction="#cercaInfoBarcode"/>
        </HBox>

        <Label text="Data Scadenza:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <DatePicker fx:id="dataScadenza" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>
        <Button text="📷" fx:id="btnScanDate" GridPane.rowIndex="4" GridPane.columnIndex="2" onAction="#initialize" styleClass="button-icon"/>

        <Label text="Quantità:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <Spinner fx:id="campoQuantità" editable="true" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>

    </GridPane>

    <Region VBox.vgrow="ALWAYS" />

    <Button fx:id="btnSalva" text="Salva" maxWidth="Infinity" onAction="#salvaProdotto" style="-fx-font-size: 14px; -fx-padding: 10;"/>

</VBox>